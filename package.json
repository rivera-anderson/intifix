{
  "name": "intifix",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/web",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=intifix-web",
    "dev:admin": "turbo run dev --filter=intifix-admin-web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}

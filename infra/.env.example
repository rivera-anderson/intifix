# =============================================================================
# IntiFix — variables de producción del VPS
# Copiar a infra/.env y llenar. NUNCA subir infra/.env a git.
# =============================================================================

# --- Dominio y HTTPS ---------------------------------------------------------
DOMAIN=intifix.com
ACME_EMAIL=tu-correo@gmail.com

# --- Imágenes (GitHub Container Registry) ------------------------------------
GHCR_OWNER=rivera-anderson
TAG=latest

# --- PostgreSQL del monolito (Aiven / Neon) ----------------------------------
DB_POSTGRES_HOST=
DB_POSTGRES_PORT=5432
DB_POSTGRES_NAME=defaultdb
DB_POSTGRES_USER=
DB_POSTGRES_PASSWORD=
DB_POSTGRES_SSLMODE=require

# --- MongoDB Atlas -----------------------------------------------------------
DB_MONGO_HOST=cluster0.xxxxx.mongodb.net
DB_MONGO_NAME=Intifix_mongo
DB_MONGO_USER=
DB_MONGO_PASSWORD=

# --- Redis (Upstash) — lo usan el gateway y el monolito ----------------------
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL=true

# --- Seguridad ---------------------------------------------------------------
# Genera con: openssl rand -base64 48
JWT_SECRET=
OPENAI_API_KEY=

# --- Cloudinary (obligatorio en producción: el disco del contenedor no es para fotos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Correo (Gmail con contraseña de aplicación) -----------------------------
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Panel admin (Django) ----------------------------------------------------
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
ADMIN_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/intifix_admin?sslmode=require
# Upstash: rediss://default:PASSWORD@HOST:6379/0
ADMIN_REDIS_URL=
ADMIN_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
ADMIN_MONGODB_DB_NAME=intifix_admin
SERVICE_API_KEY=

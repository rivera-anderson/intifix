# chat-notif-service — variables para correr en local. Copiar a .env (no se sube a git).
SPRING_PROFILES_ACTIVE=local
MONGO_URI=mongodb://localhost:27017/intifix
# Para usar la base de Atlas del monolito, borra MONGO_URI y llena DB_MONGO_*:
# DB_MONGO_HOST=cluster0.xxxxx.mongodb.net
# DB_MONGO_NAME=Intifix_mongo
# DB_MONGO_USER=
# DB_MONGO_PASSWORD=
REDIS_HOST=localhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# El MISMO valor que en el .env del monolito:
JWT_SECRET=
INTERNAL_API_KEY=
MONOLITH_URL=http://localhost:8080
